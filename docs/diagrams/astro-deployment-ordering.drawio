<mxfile host="app.diagrams.net"><diagram name="Dispatch-backed ordering hold" id="ordering-hold"><mxGraphModel page="1" pageWidth="1000" pageHeight="1100"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" value="Prepare exact immutable claim + guarded current pointer under workspace lock&#10;Three historical claims maximum; no dispatch until irreversible Begin" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry x="80" y="40" width="820" height="125" as="geometry" /></mxCell><mxCell id="3" parent="1" value="Begin under workspace lock: immutable dispatch intent + audit commit" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry x="80" y="220" width="820" height="125" as="geometry" /></mxCell><mxCell id="e3" parent="1" edge="1" source="2" target="3" style="endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="4" parent="1" value="Provider dispatch outside SQL: accepted / uncertain / lost acknowledgement&#10;IMPLEMENTED: accepted-run GET + exact identity + authority recheck; metadata only" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry x="80" y="400" width="820" height="125" as="geometry" /></mxCell><mxCell id="e4" parent="1" edge="1" source="3" target="4" style="endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="5" parent="1" value="Durable dispatch-backed hold blocks later approval&#10;Expiry, local status edits and acknowledgement alone never clear it" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry x="80" y="580" width="820" height="125" as="geometry" /></mxCell><mxCell id="e5" parent="1" edge="1" source="4" target="5" style="endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell><mxCell id="6" parent="1" value="Discharge only by verified completion OR retained safe no-write retirement&#10;Original claims/dispatches/audit remain immutable; no cancellation, reset or fake success" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f8cecc;fontSize=16;"><mxGeometry x="80" y="760" width="820" height="125" as="geometry" /></mxCell><mxCell id="e6" parent="1" edge="1" source="5" target="6" style="endArrow=block;"><mxGeometry relative="1" as="geometry" /></mxCell></root></mxGraphModel></diagram></mxfile>