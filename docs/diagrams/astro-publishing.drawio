<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net"><diagram name="Protected publishing and settlement" id="astro-v1"><mxGraphModel page="1" pageWidth="1200" pageHeight="1200"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" value="Owner: approved release → exact candidate → independently verified Pages upload" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="65" y="35" width="1050" height="120" /></mxCell><mxCell id="3" parent="1" value="Claim + current pointer under Owner/workspace lock&#10;Three historical claims maximum; immutable claim/dispatch/audit" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="65" y="195" width="1050" height="120" /></mxCell><mxCell id="e3" parent="1" edge="1" source="2" target="3" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="4" parent="1" value="Protected workflow: exact code/policy/run → pinned archive GETs → complete byte verification&#10;No extraction; no OIDC/Pages write until verified" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="355" width="1050" height="120" /></mxCell><mxCell id="e4" parent="1" edge="1" source="3" target="4" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="5" parent="1" value="CMS signed identity + current authority → consumed authorization → permanent one-write admission&#10;One Pages create outside SQL; same-run operation report" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="65" y="515" width="1050" height="120" /></mxCell><mxCell id="e5" parent="1" edge="1" source="4" target="5" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="6" parent="1" value="Owner completion: terminal exact run + expired admission + Pages operation succeeded&#10;Complete candidate/upload archives + every expected public file; repeat metadata" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="65" y="675" width="1050" height="120" /></mxCell><mxCell id="e6" parent="1" edge="1" source="5" target="6" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="7" parent="1" value="Atomic final SQL: retain verification + explicit reconciled receipt if needed&#10;Immutable completion + Astro job success + audit; other jobs unchanged" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;fontSize=16;"><mxGeometry as="geometry" x="65" y="835" width="1050" height="120" /></mxCell><mxCell id="e7" parent="1" edge="1" source="6" target="7" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="9" parent="1" value="Ordering holds discharge only for verified completion or proven no-write retirement&#10;Live/ambiguous/admitted failures remain held for investigation; hosted enablement is separate" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="995" width="1050" height="120" /></mxCell><mxCell id="end" parent="1" edge="1" source="7" target="9" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram><diagram id="astro-no-write" name="Alternative no-write recovery"><mxGraphModel page="1" pageWidth="1200" pageHeight="800"><root><mxCell id="0" /><mxCell id="1" parent="0" /><mxCell id="2" parent="1" value="Owner requests recovery for current attempt (not for a completed deployment)&#10;Current source / Owner / target policy must still match" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="35" width="1050" height="110" /></mxCell><mxCell id="3" parent="1" value="Never dispatched: no provider call&#10;Dispatched or acknowledgement lost: independently verify the exact selected terminal first run" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="180" width="1050" height="110" /></mxCell><mxCell id="e3" parent="1" edge="1" source="2" target="3" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="4" parent="1" value="Under shared workspace lock: no Pages write admission, operation report or completion&#10;Any admitted write, live / ambiguous run or stale authority rejects closure" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="325" width="1050" height="110" /></mxCell><mxCell id="e4" parent="1" edge="1" source="3" target="4" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="5" parent="1" value="Retain immutable retirement + audit; remove guarded current pointer&#10;Old authorization/admission/dispatch cannot proceed; original history stays unchanged" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="470" width="1050" height="110" /></mxCell><mxCell id="e5" parent="1" edge="1" source="4" target="5" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell><mxCell id="6" parent="1" value="Separate fresh request with new UUID only inside three-claim lifetime budget&#10;No reset, automatic retry, cancellation, deletion or fake consumer success" vertex="1" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;fontSize=16;"><mxGeometry as="geometry" x="65" y="615" width="1050" height="110" /></mxCell><mxCell id="e6" parent="1" edge="1" source="5" target="6" style="endArrow=block;"><mxGeometry as="geometry" relative="1" /></mxCell></root></mxGraphModel></diagram></mxfile>