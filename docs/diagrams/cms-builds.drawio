        </mxCell>
        <mxCell id="b3" value="4. Build EN and ID&#10;&#10;One memoized release per worker&#10;Enabled Astro placement / stable order&#10;Plain text, approved optional links" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Helvetica;fontColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fillColor=#ede9fe;" vertex="1" parent="1">
          <mxGeometry x="820" y="360" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="5. Prove static results&#10;&#10;Stop source before all builds&#10;Go normalizes initial/update/empty&#10;Inspect marker, removals and browser UI" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Helvetica;fontColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fillColor=#dcfce7;" vertex="1" parent="1">
          <mxGeometry x="440" y="360" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="6. Review future rollout&#10;&#10;No current automatic Pages adoption&#10;Add authenticated dispatch separately&#10;Verify deployed output before receipts" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Helvetica;fontColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fillColor=#f1f5f9;" vertex="1" parent="1">
