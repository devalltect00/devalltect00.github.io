        <mxCell id="b0" value="1. Read and validate&#10;&#10;UTF-8 + strict bounded JSON&#10;Go-compatible complete digest&#10;Project/Profile + reference rules" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Helvetica;fontColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fillColor=#e0f2fe;" vertex="1" parent="1">
