        <mxCell id="b1" value="2. Retain complete input&#10;&#10;Exclusive temporary child directory&#10;Write package + hash completion file&#10;Rename; never overwrite old releases" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Helvetica;fontColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fillColor=#fef3c7;" vertex="1" parent="1">
          <mxGeometry x="440" y="130" width="300" height="145" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="3. Select exact release&#10;&#10;Set process env UUID explicitly&#10;Recheck raw + projection identity&#10;Missing/corrupt pin: fail before dist" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=middle;spacing=16;fontSize=16;fontFamily=Helvetica;fontColor=#0f172a;strokeColor=#64748b;strokeWidth=1.5;fillColor=#ede9fe;" vertex="1" parent="1">
