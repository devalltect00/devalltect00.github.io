        <mxCell id="b3" value="03  Flutter and HTTP checks&#10;&#10;Owner / browser Origin / CSRF&#10;Strict body and safe error reference&#10;Mobile / dark pending controls&#10;Separate fresh-build confirmation" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
