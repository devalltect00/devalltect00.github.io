        </mxCell>
        <mxCell id="b5" value="05  Local operation&#10;&#10;Stop old API; apply migration 25&#10;Restart API and Flutter&#10;No automatic editing DB migration&#10;No new dependency or environment" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
