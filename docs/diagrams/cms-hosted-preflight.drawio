<?xml version='1.0' encoding='utf-8'?>
<mxfile host="app.diagrams.net" type="device" version="29.0.3">
  <diagram id="astro-hosted-preflight" name="Hosted source and identity readiness">
    <mxGraphModel page="1" pageWidth="1500" pageHeight="1050">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" parent="1" vertex="1" value="ASTRO HOSTED READINESS • prepared source / no deployment&#10;Existing homepage stays live; Astro CMS job remains pending" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#f1f5f9;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="35" y="20" width="1430" height="80" />
        </mxCell>
        <mxCell id="source" parent="1" vertex="1" value="Development source&#10;Go 1.27.4 + identity-only workflow&#10;Local tests and finite egress guards&#10;Operator commit / push required" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#dbeafe;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="35" y="160" width="610" height="155" />
        </mxCell>
        <mxCell id="github" parent="1" vertex="1" value="GitHub main prerequisite&#10;Initial remote lacks CMS workflows&#10;Preserve site; pause authored deploys&#10;Review exact SHA + workflow numeric IDs" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#fef3c7;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="855" y="160" width="610" height="155" />
        </mxCell>
        <mxCell id="preflight" parent="1" vertex="1" value="Identity preflight — no Pages writes&#10;Main / first run / hosted / github-pages&#10;JWT + request capability stay in memory&#10;Only public key ID and origin are reported" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#e0e7ff;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="855" y="435" width="610" height="175" />
        </mxCell>
        <mxCell id="policy" parent="1" vertex="1" value="Reviewed runtime policy&#10;Exact code / repository / workflow IDs&#10;Fixed CMS HTTPS origin and audience&#10;Observed key/origin; not CMS permission" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#dbeafe;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="35" y="435" width="610" height="175" />
        </mxCell>
        <mxCell id="secret" parent="1" vertex="1" value="Private runtime token / setup&#10;One repository: Actions RW, Contents R&#10;Protected local file / server mode 600&#10;No token in Git or workflow inputs" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#e0e7ff;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="35" y="745" width="610" height="160" />
        </mxCell>
        <mxCell id="runtime" parent="1" vertex="1" value="Existing protected publication flow&#10;Candidate → proof → stage → deploy&#10;OIDC signature + Owner / lease / one-use&#10;Independent public proof + SQL receipt" style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#dcfce7;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="855" y="745" width="610" height="160" />
        </mxCell>
        <mxCell id="a" parent="1" edge="1" source="source" target="github" value="publish reviewed source" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="b" parent="1" edge="1" source="github" target="preflight" value="inspect metadata only" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="c" parent="1" edge="1" source="preflight" target="policy" value="no JWT / no authority" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="d" parent="1" edge="1" source="policy" target="secret" value="operator handoff" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="e" parent="1" edge="1" source="secret" target="runtime" value="enable only after review" style="edgeStyle=orthogonalEdgeStyle;endArrow=block;fontSize=16;labelBackgroundColor=#ffffff;strokeColor=#475569;">
          <mxGeometry as="geometry" relative="1" />
        </mxCell>
        <mxCell id="limits" parent="1" vertex="1" value="PREFLIGHT IS NOT AUTHORIZATION: signature_verified=false / authorization=false. Actual CMS verification remains mandatory.&#10;No source push, workflow dispatch, new migration, budget reset or Astro receipt is claimed by this diagram." style="rounded=1;whiteSpace=wrap;html=0;spacing=14;fontSize=19;fillColor=#fef3c7;strokeColor=#64748b;">
          <mxGeometry as="geometry" x="35" y="960" width="1430" height="70" />
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
