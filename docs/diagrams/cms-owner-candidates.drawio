        <mxCell id="b1" value="01  Backend evidence&#10;&#10;Real isolated PostgreSQL 18 tests&#10;Concurrent admission → one call&#10;Expiry / rollback / Owner revocation&#10;85.94% handwritten Go coverage" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
