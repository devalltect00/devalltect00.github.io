        <mxCell id="b6" value="06  Remaining publication gates&#10;&#10;Protected exact-byte deployment&#10;Independent deployed-output verification&#10;Atomic attempt-fenced Astro receipt&#10;Other consumer integrations remain" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
