    </mxGraphModel>
  </diagram>
  <diagram id="astro-stage-2" name="02 — Credential and identity boundaries">
    <mxGraphModel dx="1200" dy="760" grid="1" gridSize="10" page="1" pageScale="1" pageWidth="1200" pageHeight="760">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />
        <mxCell id="title" value="02 — Credential and identity boundaries" style="text;html=0;align=left;verticalAlign=middle;fontSize=27;fontStyle=1;fontColor=#142B3A;" vertex="1" parent="1">
          <mxGeometry x="40" y="25" width="1120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="Public integrity requests are compact unsigned data; trusted review is a separate boundary." style="text;html=0;align=left;whiteSpace=wrap;fontSize=15;fontColor=#43566B;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1120" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="01  Compact frozen request&#10;&#10;Stage / candidate UUIDs and run IDs&#10;Exact reviewed code SHA&#10;Whole source ZIP + Pages gzip pins&#10;Exact release / sequence / content digests" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="140" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b2" value="02  Trusted workflow context&#10;&#10;Repository / numeric ID from GitHub&#10;Fixed candidate workflow ID variable&#10;Main ref; run_attempt = 1&#10;Request code equals workflow SHA" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b3" value="03  Authenticated API client&#10;&#10;Fixed api.github.com paths only&#10;Read-only job token; no CMS token&#10;Bounded JSON / headers / deadlines&#10;Before / after provenance must match" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="140" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b4" value="04  Isolated signed download&#10;&#10;No Authorization / Cookie / Referer&#10;Validated HTTPS host and public IP&#10;8 MiB compressed; 32 MiB expanded&#10;256 entries; 128 KiB directory bound" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="820" y="405" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b5" value="05  Public exact writer&#10;&#10;Standard library; Go 1.27.3&#10;Every binary and empty member preserved&#10;No links / PAX / aliases / filesystem paths&#10;Node compares actual upload TAR bytes" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="405" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="b6" value="06  Artifact runtime capability&#10;&#10;Read permissions still permit run upload&#10;One artifact.tar file, not a site directory&#10;No hidden-marker exclusion or dereference&#10;This is staging, not Pages deployment" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="40" y="405" width="340" height="210" as="geometry" />
        </mxCell>
        <mxCell id="footer" value="M5p · 8 November 2026 · Optional artifact staging only · No new migration · Deployment / CMS completion pending" style="text;html=0;align=left;fontSize=14;fontColor=#43566B;" vertex="1" parent="1">
          <mxGeometry x="40" y="665" width="1120" height="45" as="geometry" />
