        <mxCell id="b2" value="02  Genuine compiled handoff&#10;&#10;Initial / updated / empty candidates&#10;Private request and public Go repack&#10;Independent Node upload-TAR equality&#10;Independent + signed source modes" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
          <mxGeometry x="430" y="140" width="340" height="210" as="geometry" />
