          <mxGeometry x="40" y="25" width="1120" height="45" as="geometry" />
        </mxCell>
        <mxCell id="subtitle" value="No hosted action, environment configuration or source database migration was performed." style="text;html=0;align=left;whiteSpace=wrap;fontSize=15;fontColor=#43566B;" vertex="1" parent="1">
          <mxGeometry x="40" y="78" width="1120" height="42" as="geometry" />
        </mxCell>
        <mxCell id="b1" value="01  Go and workflow tests&#10;&#10;Pins / paths / transport rejection&#10;Before / after run / artifact drift&#10;Executable before-checkout guard&#10;Disabled configuration and no overwrites" style="rounded=1;whiteSpace=wrap;html=0;align=left;verticalAlign=top;spacing=20;fillColor=#F3F8FC;strokeColor=#8AA8C0;fontColor=#142B3A;fontSize=15;" vertex="1" parent="1">
