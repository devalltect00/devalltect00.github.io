---
import { homepageContent } from "../../data/homepage.ts";
import type { SiteCopy } from "../../types/site";
import Icon from "./Icon.astro";
import { site } from "../../data/site";

interface Props {
  message: string;
  labels: SiteCopy["contact"]["labels"];
}
const { message, labels } = Astro.props;
const state = homepageContent();
const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="shell site-footer__inner">
    <div>
      <a class="wordmark wordmark--footer" href="/" aria-label="Devalltect">
        <span class="wordmark__mark" aria-hidden="true">
          D
        </span>
        <span class="wordmark__text">DEVALLTECT</span>
      </a>
      <p>{message}</p>
    </div>
    <div class="site-footer__meta">
      <div class="site-footer__links">
        {state.contacts
          .filter((link) => link.kind !== "email")
          .map((link) => (
            <a
              href={link.href}
              target="_blank"
              rel="noopener noreferrer"
              aria-label={labels[link.kind]}
            >
              <Icon name={link.icon} size={19} />
            </a>
          ))}
      </div>
      <p>
        © {year}{" "}
        {state.source === "authored"
          ? site.author
          : (state.profile?.displayName ?? site.name)}
      </p>
    </div>
  </div>
</footer>
