---
import { homepageContent } from "../../data/homepage.ts";
import Icon from "../common/Icon.astro";
import { site } from "../../data/site";
import type { SiteCopy } from "../../types/site";

interface Props {
  copy: SiteCopy["contact"];
}

const { copy } = Astro.props;
const { contacts, source } = homepageContent();
---

<section class="section contact shell reveal" id="contact">
  <div>
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
  </div>
  <div class="contact__body">
    <p>{copy.description}</p>
    <a
      class="button button--primary"
      href={site.portfolioUrl}
      target="_blank"
      rel="noreferrer"
    >
      {copy.action}
      <Icon name="arrow" size={18} />
    </a>
    <div class="contact__links">
      {contacts.map((link) => (
        <a
          data-astro-contact={
            source === "cms-build-preview" ? link.kind : undefined
          }
          href={link.href}
          target={link.kind === "email" ? undefined : "_blank"}
          rel={link.kind === "email" ? undefined : "noopener noreferrer"}
          aria-label={copy.labels[link.kind]}
        >
          <Icon name={link.icon} />
        </a>
      ))}
      {contacts.length === 0 ? (
        <p
          data-astro-empty={
            source === "cms-build-preview" ? "contacts" : undefined
          }
        >
          {copy.noContacts}
        </p>
      ) : null}
    </div>
  </div>
</section>
