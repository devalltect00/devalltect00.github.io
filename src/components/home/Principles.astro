---
import type { SiteCopy } from "../../types/site";

interface Props {
  copy: SiteCopy["principles"];
}

const { copy } = Astro.props;
---

<section class="section section--dark" id="principles">
  <div class="shell principles-layout">
    <div class="section-heading section-heading--light reveal">
      <p class="eyebrow">{copy.eyebrow}</p>
      <h2>{copy.title}</h2>
      <p>{copy.description}</p>
    </div>
    <ol class="principle-list">
      {copy.items.map((item, index) => (
        <li class="reveal" style={`--delay: ${index * 90}ms`}>
          <span>{item.number}</span>
          <div>
            <h3>{item.title}</h3>
            <p>{item.description}</p>
          </div>
        </li>
      ))}
    </ol>
  </div>
</section>
