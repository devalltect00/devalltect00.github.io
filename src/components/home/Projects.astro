---
import Icon from "../common/Icon.astro";
import { homepageContent } from "../../data/homepage.ts";
import type { Locale, SiteCopy } from "../../types/site";

interface Props {
  locale: Locale;
  copy: SiteCopy["projects"];
}

const { locale, copy } = Astro.props;
const { projects, source } = homepageContent();
---

<section class="section shell" id="projects">
  <div class="section-heading reveal">
    <p class="eyebrow">{copy.eyebrow}</p>
    <h2>{copy.title}</h2>
    <p>{copy.description}</p>
  </div>
  {projects.length === 0 ? (
    <p
      class="projects-empty"
      data-astro-empty={source === "cms-build-preview" ? "projects" : undefined}
    >
      {copy.empty}
    </p>
  ) : null}
  <div class="project-grid">
    {projects.map((project, index) => (
      <article
        data-cms-project={
          source === "cms-build-preview" ? project.id : undefined
        }
        class={`project-card project-card--${project.accent} reveal`}
        style={`--delay: ${index * 65}ms`}
      >
        <div class="project-card__topline">
          <span
            data-astro-field={
              source === "cms-build-preview" ? "status" : undefined
            }
          >
            {project.status ? copy.statuses[project.status] : project.category}
          </span>
          {project.version ? (
            <span
              data-astro-field={
                source === "cms-build-preview" ? "version" : undefined
              }
            >
              {project.version}
            </span>
          ) : null}
        </div>
        <div class="project-card__symbol" aria-hidden="true">
          <span>{String(index + 1).padStart(2, "0")}</span>
        </div>
        <h3
          data-astro-field={
            source === "cms-build-preview" ? "title" : undefined
          }
        >
          {project.localizedName?.[locale] ?? project.name}
        </h3>
        <p
          data-astro-field={
            source === "cms-build-preview" ? "summary" : undefined
          }
        >
          {project.description[locale]}
        </p>
        <ul
          class="tag-list"
          aria-label={`${project.localizedName?.[locale] ?? project.name} ${copy.technologies}`}
        >
          {project.technologies.map((technology) => (
            <li
              data-astro-field={
                source === "cms-build-preview" ? "technology" : undefined
              }
            >
              {technology}
            </li>
          ))}
        </ul>
        <div class="project-card__links">
          {project.documentation ? (
            <a
              data-astro-link={
                source === "cms-build-preview" ? "documentation" : undefined
              }
              href={project.documentation}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.documentation}
              <Icon name="arrow" size={15} />
            </a>
          ) : null}
          {project.repository ? (
            <a
              data-astro-link={
                source === "cms-build-preview" ? "repository" : undefined
              }
              href={project.repository}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.repository}
              <Icon name="arrow" size={15} />
            </a>
          ) : null}
          {project.website ? (
            <a
              data-astro-link={
                source === "cms-build-preview" ? "website" : undefined
              }
              href={project.website}
              target="_blank"
              rel="noopener noreferrer"
            >
              {copy.website}
              <Icon name="arrow" size={15} />
            </a>
          ) : null}
        </div>
      </article>
    ))}
  </div>
</section>
