---
interface Props {
  label: string;
}

const { label } = Astro.props;
---

<button
  class="theme-toggle"
  type="button"
  data-theme-toggle
  aria-label={label}
  title={label}
>
  <svg
    class="theme-icon theme-icon--sun"
    aria-hidden="true"
    viewBox="0 0 24 24"
  >
    <circle cx="12" cy="12" r="4"></circle>
    <path d="M12 2v2M12 20v2M4.93 4.93l1.42 1.42M17.66 17.66l1.41 1.41M2 12h2M20 12h2M4.93 19.07l1.42-1.42M17.66 6.34l1.41-1.41"></path>
  </svg>
  <svg
    class="theme-icon theme-icon--moon"
    aria-hidden="true"
    viewBox="0 0 24 24"
  >
    <path d="M20.3 15.7A9 9 0 0 1 8.3 3.7a9 9 0 1 0 12 12Z"></path>
  </svg>
  <span class="sr-only">{label}</span>
</button>

<script>
  function setupThemeToggle() {
    const root = document.documentElement;
    const toggles = document.querySelectorAll<HTMLButtonElement>(
      "[data-theme-toggle]",
    );

    for (const toggle of toggles) {
      if (toggle.dataset.ready === "true") continue;
      toggle.dataset.ready = "true";
      toggle.addEventListener("click", () => {
        const next = root.dataset.theme === "dark" ? "light" : "dark";
        root.dataset.theme = next;
        localStorage.setItem("devalltect-theme", next);
      });
    }
  }

  setupThemeToggle();
  document.addEventListener("astro:after-swap", setupThemeToggle);
</script>

<style>
  .theme-toggle {
    align-items: center;
    background: var(--surface-raised);
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--text-primary);
    cursor: pointer;
    display: inline-flex;
    height: 2.65rem;
    justify-content: center;
    overflow: hidden;
    position: relative;
    transition:
      border-color 180ms ease,
      color 180ms ease,
      transform 180ms ease;
    width: 2.65rem;
  }

  .theme-toggle:hover {
    border-color: var(--secondary);
    color: var(--secondary-strong);
    transform: translateY(-2px);
  }

  .theme-icon {
    fill: none;
    height: 1.12rem;
    position: absolute;
    stroke: currentColor;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-width: 1.7;
    transition:
      opacity 280ms ease,
      transform 420ms cubic-bezier(0.22, 1, 0.36, 1);
    width: 1.12rem;
  }

  .theme-icon--sun {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }

  .theme-icon--moon {
    opacity: 0;
    transform: translateY(1.8rem) rotate(-45deg);
  }

  :global([data-theme="dark"]) .theme-icon--sun {
    opacity: 0;
    transform: translateY(1.8rem) rotate(90deg);
  }

  :global([data-theme="dark"]) .theme-icon--moon {
    opacity: 1;
    transform: translateY(0) rotate(0deg);
  }
</style>
